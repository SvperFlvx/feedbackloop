# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Three of these are not equally dangerous. Read the notes before pasting.

# ---------------------------------------------------------------------------
# Supabase — project settings > API
# ---------------------------------------------------------------------------

# The project URL. Public by design; it ships inside the app.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Project region, recorded here so it is visible rather than buried in a
# dashboard. Canada Central: client screenshots and audio stay in the country.
SUPABASE_REGION=ca-central-1

# The anon key. ALSO public by design — it is embedded in the iOS app and the
# SDK, and anyone who installs the app can read it. That is expected and safe
# ONLY because row-level security decides what it can actually see.
# Until 0002_rls.sql has been reviewed by someone who did not write it, treat
# this as a door whose lock has not been inspected.
SUPABASE_ANON_KEY=

# The service-role key. NOT public. It bypasses every row-level security
# policy, so it can read every client's feedback regardless of who is asking.
# Server-side only. Never in the iOS app, never in the SDK, never in a browser,
# never in a log line.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, for running migrations.
# Project settings > Database > Connection string.
DATABASE_URL=

# ---------------------------------------------------------------------------
# AI providers — still being chosen. See eval/README.md for how.
# Set only the one being tested; the harness reads these from the environment.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# App identity — fill in once the domain is settled
# ---------------------------------------------------------------------------

# Reverse-domain, derived from the domain rather than the GitHub handle.
# Cannot be changed after the app ships.
APP_BUNDLE_ID=
APP_CLIP_BUNDLE_ID=

# Where invite links and App Clip invocation URLs point.
PUBLIC_BASE_URL=
